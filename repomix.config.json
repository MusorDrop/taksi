{
  "$schema": "https://repomix.com/schemas/json/config.json",
  "output": {
    "filePath": ".repomix-output.xml",
    "style": "xml",
    "compress": true,
    "removeEmptyLines": true,
    "showLineNumbers": true,
    "topFilesLength": 10
  },
  "include": [
    "src/**/*",
    "package.json",
    "tsconfig.json"
  ],
  "ignore": {
    "customPatterns": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/.next/**",
      "**/*.test.*",
      "**/*.spec.*",
      "scratch/**",
      ".artifacts/**",
      "*.lock"
    ]
  }
}
