# Порт сервера
PORT=3000

# Строка подключения к PostgreSQL с установленным расширением PostGIS
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/poputka_db

# Секретный ключ для подписи JWT токенов (не менее 32 символов)
JWT_SECRET=poputka_super_secret_jwt_key_example_32chars

# Секретный ключ администратора для доступа к API администрирования (ровно 30 символов)
ADMIN_SECRET=poputka_admin_secret_key_30chr

# Разрешенные CORS-источники (через запятую)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Часовой пояс приложения для расчета часов пик
APP_TIMEZONE=Asia/Yekaterinburg

# Окружение (development, production, test)
NODE_ENV=development

# Яндекс Карты API (Геокодер, Маршрутизатор, Подсказки)
YANDEX_MAPS_API_KEY=your_yandex_maps_geocoder_api_key
YANDEX_ROUTER_API_KEY=your_yandex_router_api_key
YANDEX_SUGGEST_API_KEY=your_yandex_suggest_api_key
 
+# Интеграция с GigaChat API (Сбер)
+GIGACHAT_CLIENT_ID=your_gigachat_client_id
+GIGACHAT_CLIENT_SECRET=your_gigachat_client_secret
+GIGACHAT_SCOPE=GIGACHAT_API_PERS
